# Copie este arquivo para ".env" (o .env NAO vai para o git).
# Com estes valores o backend conecta tanto pelo Docker quanto rodando no IntelliJ,
# porque sao os mesmos padroes do application.yml.

# Nome do banco que o Postgres vai criar
POSTGRES_DB=restmanager
# Usuário e senha do banco
POSTGRES_USER=restmanager
POSTGRES_PASSWORD=restmanager
# Segredo usado para assinar os tokens de login (JWT) - minimo de 32 caracteres
JWT_SECRET=segredo-de-desenvolvimento-com-mais-de-32-caracteres
